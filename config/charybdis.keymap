#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC         &kp N1   &kp N2   &kp N3   &kp N4           &kp N5         &kp N6      &kp N7     &kp N8     &kp N9   &kp N0           &kp MINUS
&kp DEL         &kp Q    &kp W    &kp E    &kp R            &kp T          &kp Y       &kp U      &kp I      &kp O    &kp P            &kp BSLH
&lt 1 BACKSPACE   &lt 5 A  &lt 4 S  &kp D    &lt 3 F          &kp G          &kp H       &kp J      &kp K      &kp L    &lt 6 SEMICOLON  &lt 1 SQT
&kp LEFT_SHIFT  &lt 2 Z  &kp X    &kp C    &kp V            &kp B          &kp N       &kp M      &kp COMMA  &kp DOT  &lt 2 SLASH      &lt 3 RIGHT_SHIFT
                                  &kp TAB  &kp SPACE        &lt 1 ENTER    &kp DELETE  &kp ENTER
                                           &kp LA(LC(DEL))  &kp LCTRL      &kp SPACE
            >;
        };

        F_layers {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6    &kp F7     &kp F8     &kp F9  &kp F10    &kp F11    &kp F12
&trans  &none   &none   &none   &none   &trans    &none      &none      &none   &trans     &mkp MB4   &trans
&trans  &none   &none   &none   &none   &trans    &mkp RCLK  &mkp LCLK  &trans  &mkp MCLK  &mkp RCLK  &trans
&trans  &trans  &trans  &trans  &trans  &none     &none      &none      &trans  &mkp LCLK  &mkp MB5   &trans
                        &trans  &trans  &trans    &mkp RCLK  &mkp LCLK
                                &trans  &trans    &trans
            >;
        };

        BT_layers {
            bindings = <
&bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3   &bt BT_SEL 4    &trans           &trans         &trans     &trans     &trans     &trans
&trans          &trans        &trans        &kp RG(UP_ARROW)  &trans         &bt BT_NXT      &kp LC(Y)        &trans         &trans     &trans     &trans     &trans
&trans          &trans        &kp RG(LEFT)  &kp RG(DOWN)      &kp RG(RIGHT)  &trans          &kp LC(Z)        &kp LC(C)      &kp LC(V)  &kp LC(X)  &kp LC(A)  &kp LC(F)
&trans          &trans        &trans        &trans            &trans         &trans          &trans           &kp LC(S)      &trans     &trans     &trans     &trans
                                            &kp CAPS          &trans         &trans          &kp PAGE_UP      &kp PAGE_DOWN
                                                              &trans         &trans          &kp PRINTSCREEN
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans     &mkp MB4   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp RCLK  &mkp LCLK  &trans  &mkp MCLK  &mkp RCLK  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &mkp LCLK  &mkp MB5   &trans
                        &trans  &trans  &trans    &mkp RCLK  &mkp LCLK
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans     &mkp MB4   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp RCLK  &mkp LCLK  &trans  &mkp MCLK  &mkp RCLK  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &mkp LCLK  &mkp MB5   &trans
                        &trans  &trans  &trans    &mkp RCLK  &mkp LCLK
                                &trans  &trans    &trans
            >;
        };

        Numbers {
            bindings = <
&trans  &trans  &trans     &trans                &trans                 &trans         &trans           &trans        &trans        &trans        &trans         &trans
&trans  &trans  &kp PIPE   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PERCENT    &kp EXCLAMATION  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK   &trans
&trans  &trans  &kp HASH   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS      &kp AT_SIGN      &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp EQUAL      &kp CARET
&trans  &trans  &kp TILDE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp CARET      &kp UNDER        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH  &trans
                           &trans                &trans                 &trans         &kp PERIOD       &kp N0
                                                 &trans                 &trans         &kp AMPS
            >;
        };

        SecMov {
            bindings = <
&trans  &trans  &trans          &trans        &trans     &trans       &trans          &trans          &trans           &trans  &trans  &trans
&trans  &trans  &trans          &kp UP_ARROW  &trans     &trans       &trans          &msc SCRL_UP    &trans           &trans  &trans  &trans
&trans  &trans  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT  &trans       &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans  &trans  &trans
&trans  &trans  &trans          &trans        &trans     &trans       &trans          &trans          &trans           &trans  &trans  &trans
                                &mkp MCLK     &mkp LCLK  &mkp RCLK    &mkp RCLK          &mkp LCLK
                                              &mkp MB4   &mkp MB5     &mkp MCLK
            >;
        };
    };
};
